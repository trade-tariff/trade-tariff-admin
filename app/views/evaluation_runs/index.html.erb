<h1 class="govuk-heading-l">Evaluation runs</h1>

<% if @runs.any? %>
  <table class="govuk-table">
    <caption class="govuk-table__caption govuk-table__caption--s"><%= pluralize(@runs.total_count, "run") %></caption>
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th class="govuk-table__header" scope="col">Run</th>
        <th class="govuk-table__header" scope="col">Status</th>
        <th class="govuk-table__header" scope="col">Progress</th>
        <th class="govuk-table__header" scope="col">Started</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      <% @runs.each do |run| %>
        <tr class="govuk-table__row">
          <td class="govuk-table__cell"><%= link_to "Run ##{run.resource_id}", evaluation_run_path(run), class: "govuk-link" %></td>
          <td class="govuk-table__cell"><%= run.status %></td>
          <td class="govuk-table__cell"><%= run.result_count %> of <%= run.error_count.to_i + run.result_count.to_i %> so far</td>
          <td class="govuk-table__cell"><%= run.created_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @runs %>
<% else %>
  <div class="govuk-inset-text">
    <p class="govuk-body">No runs yet.</p>
  </div>
<% end %>
