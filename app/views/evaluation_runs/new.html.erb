<h1 class="govuk-heading-l">Launch an evaluation</h1>

<%
  # An experiment has at most one of these two ids set (enforced on the backend), so exactly
  # one branch below ever finds anything -- the other's lookup is simply never reached. Both
  # kinds report "Unknown (set may have been deleted)" the same way, rather than only the
  # gold-query-set one, so a synthetic input set experiment doesn't wrongly look like a set
  # that still exists has gone missing when really this code just never looked for it.
  experiments_data = @experiments.map { |e|
    source_name, source_item_count =
      if e.synthetic_input_set_id
        synthetic_input_set = @synthetic_input_sets_by_id[e.synthetic_input_set_id.to_s]
        [synthetic_input_set&.name, synthetic_input_set&.actual_size]
      else
        gold_query_set = @gold_query_sets_by_id[e.gold_query_set_id.to_s]
        [gold_query_set&.name, gold_query_set&.item_count]
      end

    [
      e.resource_id.to_s,
      {
        overrides: e.configuration_overrides,
        source_name: source_name || "Unknown (set may have been deleted)",
        source_item_count: source_item_count,
      },
    ]
  }.to_h
%>

<%= govuk_form_for @run,
                   as: :evaluation_run,
                   url: evaluation_runs_path,
                   html: { data: { controller: "run-preview", "run-preview-baseline-value": @configuration_schema[:baseline].to_json, "run-preview-experiments-value": experiments_data.to_json } } do |f| %>
  <%= f.govuk_error_summary %>
  <%= f.hidden_field :idempotency_key, value: @idempotency_key %>

  <%= f.govuk_collection_select :experiment_id,
                                @experiments,
                                :resource_id,
                                :name,
                                label: { text: "Experiment", size: "s" },
                                options: { include_blank: "Choose an experiment", selected: params[:experiment_id] || @run.experiment_id },
                                data: { "run-preview-target": "experimentSelect", action: "change->run-preview#render" } %>

  <%= render "override_fields",
             f: f,
             override_schema: @configuration_schema[:allowed_overrides],
             baseline: @configuration_schema[:baseline],
             search_index: @configuration_schema[:search_index] %>

  <div class="govuk-inset-text" data-run-preview-target="preview">
    <h2 class="govuk-heading-s">Preview</h2>
    <p class="govuk-body">Choose an experiment to see what this run will use.</p>
  </div>

  <%= submit_and_back_buttons f, evaluation_experiments_path, submit: "Launch" %>
<% end %>
