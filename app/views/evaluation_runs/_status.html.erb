<%# The real total a run works through: one gold query per persona per item, not the number of
    items (atar_count/synthetic_atar_count deliberately deduplicate by item, for the "N items"
    display elsewhere) — see EvaluationGoldQuerySet.gold_query_counts on the backend. %>
<% total_items = @gold_query_set ? @gold_query_set.gold_query_count.to_i : 0 %>

<% if @run.generating? %>
  <div class="govuk-notification-banner" role="status" aria-live="polite">
    <div class="govuk-notification-banner__content">
      <p class="govuk-notification-banner__heading">
        <span class="app-spinner" data-run-tracking-target="spinner" aria-hidden="true"></span>
        <%= @run.status.capitalize %>: <%= @run.finished_count %> of <%= total_items %> done
      </p>
      <% if (eta = evaluation_run_eta(@run, total_items)) %>
        <p class="govuk-body"><%= eta %></p>
      <% end %>
      <% if evaluation_run_running_a_while?(@run) %>
        <p class="govuk-body">This run has been going for a while. This page will keep updating — feel free to leave it open.</p>
      <% end %>
      <p class="govuk-body" data-run-tracking-target="message"></p>
    </div>
  </div>

  <%= button_to "Cancel run", cancel_evaluation_run_path(@run), class: "govuk-button govuk-button--warning" %>
<% else %>
  <%# This whole partial, not show.html.erb, is what the tracking page's live polling replaces
      (run_tracking_controller.js sets statusTarget.innerHTML from it on every poll) — a back
      link placed in show.html.erb instead would never appear for a run that finishes while the
      operator is already watching it, only for one loaded fresh after it was already done. %>
  <%= link_to "Back to experiments", evaluation_experiments_path, class: "govuk-back-link" %>

  <h2 class="govuk-heading-m">Summary</h2>
  <dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Status</dt>
      <dd class="govuk-summary-list__value"><%= @run.status.humanize %></dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Results</dt>
      <dd class="govuk-summary-list__value"><%= @run.finished_count %> of <%= total_items %> done, <%= @run.error_count %> failed</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Accuracy</dt>
      <dd class="govuk-summary-list__value"><%= evaluation_run_rate(@run.top1_rate) %> in top 1, <%= evaluation_run_rate(@run.top5_rate) %> in top 5</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Cost</dt>
      <dd class="govuk-summary-list__value">Total <%= @run.total_cost_usd %>, average <%= evaluation_run_average(@run.total_cost_usd, @run.result_count) %> per result</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Latency</dt>
      <dd class="govuk-summary-list__value">Average <%= evaluation_run_seconds(@run.average_latency_seconds) %> per result</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Started</dt>
      <dd class="govuk-summary-list__value"><%= @run.started_at %></dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Completed</dt>
      <dd class="govuk-summary-list__value"><%= @run.completed_at %></dd>
    </div>
  </dl>
  <% if @run.error_summary.present? %>
    <p class="govuk-body"><%= @run.error_summary %></p>
  <% end %>

  <h2 class="govuk-heading-m">Extremes</h2>
  <p class="govuk-body">Worth a look before paging through every result individually.</p>
  <dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Most expensive</dt>
      <dd class="govuk-summary-list__value"><%= evaluation_run_outlier_link(@run, :max_cost_result, "cost_usd") %></dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Least expensive</dt>
      <dd class="govuk-summary-list__value"><%= evaluation_run_outlier_link(@run, :min_cost_result, "cost_usd") %></dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Slowest</dt>
      <dd class="govuk-summary-list__value"><%= evaluation_run_outlier_link(@run, :max_latency_result, "latency_seconds") %></dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Fastest</dt>
      <dd class="govuk-summary-list__value"><%= evaluation_run_outlier_link(@run, :min_latency_result, "latency_seconds") %></dd>
    </div>
  </dl>

  <%= render "configuration", run: @run, experiment: @experiment %>

  <%= link_to "View results", evaluation_run_results_path(@run), class: "govuk-button govuk-button--secondary" %>
<% end %>
