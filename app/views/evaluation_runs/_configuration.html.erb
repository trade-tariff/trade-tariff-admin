<h2 class="govuk-heading-m">Configuration used</h2>

<table class="govuk-table">
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col">Setting</th>
      <th class="govuk-table__header" scope="col">Value</th>
      <th class="govuk-table__header" scope="col">Source</th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    <% run.configuration_breakdown(experiment).each do |entry| %>
      <tr class="govuk-table__row">
        <td class="govuk-table__cell"><%= entry[:name].humanize %></td>
        <td class="govuk-table__cell"><%= entry[:value] %></td>
        <td class="govuk-table__cell">
          <% case entry[:source] %><% when "run" %>Overridden for this run
          <% when "experiment" %>From the experiment's own default
          <% else %>Baseline, not overridden
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
