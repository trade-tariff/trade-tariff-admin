<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Search diagnostics</h1>

    <% if @related_diagnostics %>
      <% if params[:browser_session_id].present? %>
        <p class="govuk-body" style="overflow-wrap: anywhere;">Browser session <%= params[:browser_session_id] %></p>
      <% elsif params[:experiment].present? %>
        <p class="govuk-body">Experiment <%= params[:experiment] %></p>
      <% end %>
      <p class="govuk-body">Showing requests from <%= @list_window %>. Select a request to open its diagnostics.</p>
      <%= render "search_diagnostics/request_links", requests: @related_diagnostics.map { |diagnostic| { request_id: diagnostic.request_id, occurred_at: diagnostic.occurred_at, query: diagnostic.query } } %>
    <% end %>

    <%= form_with url: search_diagnostics_path, method: :get do |form| %>
      <div class="govuk-form-group">
        <%= form.label :search_reference, "Request ID, browser session, or experiment", class: "govuk-label" %>
        <div id="search-reference-hint" class="govuk-hint">
          Enter a request ID, browser session ID, or experiment name. Experiment and session lists show requests from today, up to 20.
        </div>
        <%= form.text_field :search_reference,
              value: params[:search_reference],
              class: "govuk-input",
              "aria-describedby": "search-reference-hint",
              autocomplete: "off" %>
      </div>

      <div class="govuk-button-group">
        <%= form.submit "Find diagnostics", class: "govuk-button" %>
      </div>
    <% end %>
  </div>
</div>
