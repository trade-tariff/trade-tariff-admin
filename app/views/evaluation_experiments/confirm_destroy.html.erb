<%= govuk_breadcrumbs "Evaluation experiments": evaluation_experiments_path %>

<h1 class="govuk-heading-l">Are you sure you want to delete this experiment?</h1>

<%= govuk_warning_text(text: "This deletes the experiment and all #{pluralize(@run_count, 'run')} made from it, along with their results. It cannot be undone.") %>

<%= govuk_summary_list(rows: [
  { key: { text: "Name" }, value: { text: @experiment.name } },
  { key: { text: "Runs" }, value: { text: @run_count.to_s } },
]) %>

<div class="govuk-button-group">
  <%= govuk_button_to "Delete experiment",
                      evaluation_experiment_path(@experiment),
                      method: :delete,
                      warning: true,
                      prevent_double_click: true %>
  <%= govuk_link_to "Cancel", evaluation_experiments_path %>
</div>
