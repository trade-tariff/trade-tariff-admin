<%= govuk_breadcrumbs "Evaluation experiments": evaluation_experiments_path %>

<h1 class="govuk-heading-l">New experiment</h1>

<%= govuk_form_for @experiment,
                   as: :evaluation_experiment,
                   url: evaluation_experiments_path do |f| %>
  <%= f.govuk_error_summary %>

  <%= f.govuk_text_field :name,
                         label: { text: "Name", size: "s" },
                         hint: { text: "A name that is not used by another experiment." },
                         width: "two-thirds" %>

  <%= f.govuk_text_area :description,
                        label: { text: "Description", size: "s" },
                        rows: 2 %>

  <% source_hint = "Every run launched from this experiment scores against the set chosen here, unless a different one is chosen at launch time. This cannot be changed once chosen." %>

  <% if EvaluationGoldQuerySet.entry_points_enabled? %>
    <%= f.govuk_radio_buttons_fieldset :source_type,
                                       legend: { text: "Source", size: "s" },
                                       hint: { text: source_hint } do %>
      <%= f.govuk_radio_button :source_type, "gold_query_set", label: { text: "Gold query set" } do %>
        <%= f.govuk_collection_select :gold_query_set_id,
                                      @gold_query_sets,
                                      :resource_id,
                                      :name,
                                      label: { text: "Gold query set", size: "s" },
                                      options: { include_blank: "Choose later" } %>
      <% end %>
      <%= f.govuk_radio_button :source_type, "synthetic_input_set", label: { text: "Synthetic input set" } do %>
        <%= render "synthetic_input_set_picker", f: f, hint: nil %>
      <% end %>
    <% end %>
  <% else %>
    <%= render "synthetic_input_set_picker", f: f, hint: { text: source_hint } %>
  <% end %>

  <%= submit_and_back_buttons f, evaluation_experiments_path, submit: "Create experiment" %>
<% end %>
