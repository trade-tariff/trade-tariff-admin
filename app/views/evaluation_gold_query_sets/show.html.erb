<div data-controller="run-tracking"
     data-run-tracking-pending-value="<%= @gold_query_set.generating? %>"
     data-run-tracking-url-value="<%= evaluation_gold_query_set_path(@gold_query_set, format: :json) %>">
  <%= govuk_breadcrumbs "Gold query sets": evaluation_gold_query_sets_path %>

  <span class="govuk-caption-l">Gold query set</span>
  <h1 class="govuk-heading-l"><%= @gold_query_set.name %></h1>

  <div data-run-tracking-target="status" role="status" aria-live="polite">
    <%= render "status" %>
  </div>
</div>
