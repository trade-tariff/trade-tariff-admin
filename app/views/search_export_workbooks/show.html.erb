<% content_for :title, "Classifier workbook" %>

<div class="govuk-width-container"
     data-controller="workbook"
     data-workbook-pending-value="<%= @export.pending? %>"
     data-workbook-url-value="<%= search_export_workbook_path(@export.resource_id, format: :json) %>">
  <h1 class="govuk-heading-l">Classifier workbook</h1>
  <p class="govuk-body"><%= workbook_date_label(@export, params[:preset]) %></p>
  <div data-workbook-target="status" role="status" aria-live="polite">
    <%= render "status" %>
  </div>
</div>
