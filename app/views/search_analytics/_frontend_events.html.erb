<% if @view != "classic" && frontend_events.dig(:coverage, :supported) %>
  <section class="govuk-!-margin-top-6" aria-labelledby="frontend-events-heading">
    <h2 id="frontend-events-heading" class="govuk-heading-m">Guided search events</h2>
    <% if frontend_events[:available] %>
      <% coverage = frontend_events.fetch(:coverage) %>
      <% unless coverage[:complete] %>
        <%= govuk_inset_text(text: "Frontend event coverage is incomplete. Figures describe collected days only; missing days are not zero-activity days.") %>
      <% end %>
      <% if frontend_events[:observed_journeys] == 0 %>
        <p class="govuk-body">No guided-search events were recorded for these collected days. This does not establish whether frontend telemetry was available.</p>
      <% else %>
        <p class="govuk-body">Observed journeys: <%= search_analytics_number(frontend_events[:observed_journeys]) %>.
          <% if frontend_events[:observed_sessions] %>
            Observed browser sessions: <%= search_analytics_number(frontend_events[:observed_sessions]) %>.
          <% end %>
        </p>
        <table class="govuk-table">
          <caption class="govuk-table__caption govuk-table__caption--s">Observed page outcomes</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <% ["Outcome", "Page events", "Average wait for page"].each do |heading| %>
                <th scope="col" class="govuk-table__header"><%= heading %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            <% Array(frontend_events[:outcomes]).each do |row| %>
              <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header"><%= row[:outcome].to_s.humanize %></th>
                <td class="govuk-table__cell"><%= row[:rendered_events].nil? ? "Unavailable" : search_analytics_number(row[:rendered_events]) %></td>
                <td class="govuk-table__cell"><%= search_analytics_latency(row[:average_navigation_ms]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% actions = search_analytics_frontend_action_rows(frontend_events[:actions]) %>
        <h3 class="govuk-heading-s">Recorded actions</h3>
        <% if actions.sum(&:last).positive? %>
          <div class="search-analytics-chart-container search-analytics-actions-chart">
            <canvas class="search-analytics-chart" data-chart-type="pie"
                    data-chart="<%= search_analytics_frontend_chart_payload(actions, label: "Recorded actions", pie: true) %>"
                    role="img" aria-label="Recorded actions. View action data below for the counts."></canvas>
          </div>
        <% else %>
          <p class="govuk-body">No actions recorded.</p>
        <% end %>
        <%= render GovukComponent::DetailsComponent.new(summary_text: "View action data") do %>
          <%= govuk_table(head: ["Action", "Recorded events"], rows: actions.map { |label, count| [label, search_analytics_number(count)] }) %>
        <% end %>

        <% selections = search_analytics_frontend_selection_rows(frontend_events[:selections]) %>
        <% if selections.any? %>
          <h3 class="govuk-heading-s">Result selections by rank and confidence</h3>
          <%= govuk_table(head: ["Selection", "Recorded events"], rows: selections.map { |label, count| [label, search_analytics_number(count)] }) %>
        <% end %>

        <% questions = search_analytics_frontend_question_rows(frontend_events[:question_counts]) %>
        <h3 class="govuk-heading-s">Reported questions per journey</h3>
        <div class="search-analytics-chart-container">
          <canvas class="search-analytics-chart" data-chart-type="bar"
                  data-x-axis-title="Reported questions" data-y-axis-title="Journeys" data-hide-legend="true" data-hide-x-grid="true"
                  data-chart="<%= search_analytics_frontend_chart_payload(questions, label: "Journeys") %>"
                  role="img" aria-label="Reported questions per journey. View question data below for the counts."></canvas>
        </div>
        <%= render GovukComponent::DetailsComponent.new(summary_text: "View question data") do %>
          <%= govuk_table(head: ["Maximum reported questions", "Observed journeys"], rows: questions.map { |label, count| [label, search_analytics_number(count)] }) %>
          <p class="govuk-body-s">Uses the highest reported count per journey. Unknown is separate from zero.</p>
        <% end %>
      <% end %>
    <% else %>
      <p class="govuk-body">Frontend events have not been collected for these dates. Existing search metrics remain available. Opening this page does not start collection.</p>
    <% end %>
  </section>
<% end %>
