<table class="govuk-table" id="<%= table_id %>">
  <% if local_assigns[:caption] %>
    <caption class="govuk-table__caption govuk-table__caption--s"><%= caption %></caption>
  <% end %>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header"><%= label_heading %></th>
      <th scope="col" class="govuk-table__header govuk-table__header--numeric"><%= count_heading %></th>
      <th scope="col" class="govuk-table__header govuk-table__header--numeric"><%= share_heading %></th>
      <% if local_assigns[:extra_heading] %>
        <th scope="col" class="govuk-table__header"><%= extra_heading %></th>
      <% end %>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    <% labels.each_with_index do |label, index| %>
      <tr class="govuk-table__row">
        <th scope="row" class="govuk-table__header"><%= label %></th>
        <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_count_text(counts[index]) %></td>
        <td class="govuk-table__cell govuk-table__cell--numeric"><%= summary[:shares][index] %></td>
        <% if local_assigns[:extras] %>
          <td class="govuk-table__cell"><%= extras[index] %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
  <tfoot class="govuk-table__foot">
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header"><%= summary[:total_label] %></th>
      <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_count_text(summary[:total]) %></td>
      <td class="govuk-table__cell govuk-table__cell--numeric"><%= summary[:total_share] %></td>
      <% if local_assigns[:extras] %>
        <td class="govuk-table__cell"><%= total_extra %></td>
      <% end %>
    </tr>
  </tfoot>
</table>
<% if local_assigns[:extra_note] %>
  <p class="govuk-body-s"><%= extra_note %></p>
<% end %>
<p class="govuk-body-s"><%= summary[:base_note] %></p>
