<% content_for :page_title, "Search dashboard" %>

<% summary = (@search_analytics.summary || {}).with_indifferent_access %>
<% statuses = (@search_analytics.summary_statuses || {}).with_indifferent_access %>
<% trends = (@search_analytics.trends || {}).with_indifferent_access %>
<% ai_costs = (@search_analytics.ai_costs || {}).with_indifferent_access %>
<% ai_cost_summary = (ai_costs[:summary] || {}).with_indifferent_access %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l">Search dashboard</h1>

    <% if @date_range_error %>
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">There is a problem</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <% %w[From To].each do |label| %>
                <li><%= link_to "#{label}: #{@date_range_error}", "##{label.downcase}" %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <div class="search-analytics-filters govuk-!-margin-bottom-5">
      <div>
        <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Period</h2>
        <div class="govuk-button-group">
          <% [["24h", "24 hours"], ["7d", "7 days"], ["30d", "30 days"]].each do |period, label| %>
            <%= link_to label,
                        search_analytics_path(period: period, view: @view),
                        class: ["govuk-link", ("govuk-!-font-weight-bold" if @period == period)].compact.join(" ") %>
          <% end %>
        </div>
      </div>
      <div>
        <h2 class="govuk-heading-s govuk-!-margin-bottom-2">View</h2>
        <div class="govuk-button-group">
          <% [["all", "All"], ["classic", "Classic"], ["internal", "Internal"]].each do |view, label| %>
            <%= link_to label,
                        search_analytics_path(@analytics_params.merge(view: view)),
                        class: ["govuk-link", ("govuk-!-font-weight-bold" if @view == view)].compact.join(" ") %>
          <% end %>
        </div>
      </div>
      <%= form_with url: search_analytics_path, method: :get, local: true, class: "search-analytics-date-range" do %>
        <%= hidden_field_tag :period, "custom" %>
        <%= hidden_field_tag :view, @view %>
        <% date_description = @date_range_error ? "date-range-hint date-range-error" : "date-range-hint" %>
        <fieldset class="govuk-fieldset" aria-describedby="<%= date_description %>">
          <legend class="govuk-visually-hidden">Date range (UTC)</legend>
          <p id="date-range-hint" class="govuk-visually-hidden">Both dates are included, in UTC. Choose up to 366 days, ending yesterday or earlier. Missing dates will not trigger collection.</p>
          <% if @date_range_error %>
            <p id="date-range-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> <%= @date_range_error %></p>
          <% end %>
          <% [[:from, @from], [:to, @to]].each do |name, date| %>
            <div class="govuk-form-group<%= ' govuk-form-group--error' if @date_range_error %>">
              <%= label_tag name, name.to_s.capitalize, class: "govuk-label" %>
              <%= date_field_tag name, date, required: true, max: @latest_date, class: "govuk-input#{' govuk-input--error' if @date_range_error}", aria: { describedby: date_description, invalid: @date_range_error.present? } %>
            </div>
          <% end %>
          <%= submit_tag "Apply dates", class: "govuk-button" %>
        </fieldset>
      <% end %>
    </div>

    <% unless @analytics_unavailable %>
    <% coverage = (@search_analytics.coverage || {}).with_indifferent_access %>
    <% availability = (@search_analytics.availability || {}).with_indifferent_access %>
    <% if coverage[:complete] == false %>
      <%= govuk_inset_text do %>
        Incomplete coverage: <%= coverage[:collected_days] %> of <%= coverage[:expected_days] %> UTC days have stored results.
        Some widgets may cover fewer days. Missing days are not zero-traffic days.
      <% end %>
    <% end %>
    <% if availability[:range_percentiles] == false %>
      <p class="govuk-body">Range percentiles are unavailable because daily percentiles cannot be combined accurately.</p>
    <% end %>

    <div class="search-analytics-metrics">
      <% [
        ["Search requests", availability[:journey_metrics] ? search_analytics_number(summary[:searches]) : "Unavailable", statuses[:searches]],
        ["Failure rate", search_analytics_percentage(summary[:failure_rate]), statuses[:failure_rate]],
        ["Zero-result rate", search_analytics_percentage(summary[:zero_result_rate]), statuses[:zero_result_rate]],
        ["Selection rate", search_analytics_percentage(summary[:selection_rate]), statuses[:selection_rate]],
        [availability[:latency_percentiles_approximate] ? "P90 latency (approx.)" : "P90 latency", search_analytics_latency(summary[:p90_latency_ms]), statuses[:p90_latency_ms]],
      ].each do |label, value, status| %>
        <% status = value == "Unavailable" ? {} : (status || {}).with_indifferent_access %>
        <section class="search-analytics-metric" aria-label="<%= label %>">
          <h2 class="govuk-heading-s"><%= label %></h2>
          <p class="search-analytics-metric__value"><%= value %></p>
          <% if status[:level].present? %>
            <%= govuk_tag(text: status[:level].to_s.humanize, colour: search_analytics_status_tag_colour(status[:level])) %>
          <% end %>
          <% if status[:message].present? %>
            <p class="govuk-body-s govuk-!-margin-top-2"><%= status[:message] %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <%= render GovukComponent::DetailsComponent.new(summary_text: "How these metrics are calculated", classes: "govuk-!-margin-top-4") do %>
      <%= govuk_summary_list(
            borders: false,
            classes: "search-analytics-metric-definitions",
            rows: [
              {
                key: { text: "Search requests" },
                value: { text: "Distinct request IDs with search activity in the selected period and view. Repeated questions and answers count as one journey." },
              },
              {
                key: { text: "Failure rate" },
                value: { text: "Failed requests divided by all requests, not by journeys." },
              },
              {
                key: { text: "Zero-result rate" },
                value: { text: "Classic counts responses with no commodity results; Internal counts responses with no results. The rate uses completed requests, not journeys." },
              },
              {
                key: { text: "Selection rate" },
                value: { text: "Result selections divided by eligible searches. Eligible searches are classic fuzzy searches and internal searches that return ranked confidence results. Can exceed 100% when users open more than one result." },
              },
              {
                key: { text: "Outcome trend" },
                value: { text: "Uses the same frontend journeys as Search requests. Completed means a final backend response, not a question step. Question only and Unknown show journeys without a recognised final outcome. Selected and Zero result can overlap with other states. Outcomes are shown in the journey's observed start buckets." },
              },
              {
                key: { text: "P90 latency" },
                value: { text: "About 90% of measured searches finished within this time." },
              },
            ],
          ) %>
    <% end %>

    <% if !availability[:journey_metrics] %>
      <p class="govuk-body">Search journeys<%= " and their AI costs" unless @view == "classic" %> need to be collected for this date range. Older request counts are not journey counts.</p>
    <% end %>
    <% unless @view == "classic" %>
    <% if availability[:journey_metrics] && availability[:costs_match_view] != true %>
      <p class="govuk-body">Matching AI cost data is not available for the selected view.</p>
    <% end %>
    <% if availability[:journey_metrics] && availability[:costs_match_view] == true && search_analytics_query_collected?(coverage, :ai_cost_trend) %>
    <% if availability[:unattributed_cost_requests].to_i.positive? %>
      <p class="govuk-body">AI costs that could not be linked to search journeys in this period are not included.</p>
    <% end %>
    <section class="search-analytics-ai-cost govuk-!-margin-top-7" aria-labelledby="ai-cost-heading">
      <h2 id="ai-cost-heading" class="govuk-heading-l govuk-!-margin-bottom-3">AI cost</h2>
      <p class="govuk-body">Total recorded AI cost in US dollars for these journeys during the selected period, including embeddings, query expansion and every question or ranking call.</p>

      <% if ai_cost_summary[:unpriced_calls].to_i.positive? %>
        <%= govuk_inset_text do %>
          Costs are unavailable for <%= search_analytics_number(ai_cost_summary[:unpriced_calls]) %> recorded AI calls. The total includes known costs only.
        <% end %>
      <% end %>
        <div class="search-analytics-metrics search-analytics-ai-cost__metrics govuk-!-margin-top-5">
          <% [
            [ai_cost_summary[:complete] ? "Estimated AI cost" : "Known AI cost", search_analytics_cost(ai_cost_summary[:total_cost_usd])],
          ].each do |label, value| %>
            <section class="search-analytics-metric" aria-label="<%= label %>">
              <h3 class="govuk-heading-s"><%= label %></h3>
              <p class="search-analytics-metric__value"><%= value %></p>
            </section>
          <% end %>
        </div>

        <% ai_cost_trend = Array(ai_costs[:trend]) %>
        <% if ai_cost_trend.any? %>
          <section class="search-analytics-ai-cost__chart govuk-!-margin-top-6" aria-labelledby="ai-cost-trend-heading">
            <h3 id="ai-cost-trend-heading" class="govuk-heading-m">Cost over time</h3>
            <div class="search-analytics-chart-container">
              <canvas class="search-analytics-chart"
                      role="img"
                      aria-label="Estimated AI cost over time"
                      data-chart-type="bar"
                      data-y-axis-format="currency"
                      data-chart="<%= search_analytics_cost_chart_payload(ai_cost_trend, bucket_size: @search_analytics.bucket_size) %>">
                AI cost over time. Use the data table below for values rounded to cents.
              </canvas>
            </div>

            <%= render GovukComponent::DetailsComponent.new(summary_text: "View AI cost chart data", classes: "govuk-!-margin-top-3") do %>
              <table class="govuk-table">
                <thead class="govuk-table__head">
                  <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header"><%= @search_analytics.bucket_size == "hour" ? "Date and hour (UTC)" : "Date" %></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric">Estimated AI cost</th>
                  </tr>
                </thead>
                <tbody class="govuk-table__body">
                  <% ai_cost_trend.each do |row| %>
                    <% row = row.with_indifferent_access %>
                    <tr class="govuk-table__row">
                      <th scope="row" class="govuk-table__header"><%= search_analytics_bucket_date(row[:bucket], bucket_size: @search_analytics.bucket_size) %></th>
                      <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_cost(row[:total_cost_usd]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </section>
        <% end %>

        <% operation_rows = search_analytics_ai_operation_rows(ai_costs[:operations], total_cost: ai_cost_summary[:total_cost_usd]) %>
        <% if operation_rows.any? %>
          <section class="search-analytics-ai-cost__breakdown govuk-!-margin-top-6" aria-labelledby="ai-cost-breakdown-heading">
            <h3 id="ai-cost-breakdown-heading" class="govuk-heading-m">Cost by operation</h3>
            <table class="govuk-table">
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">Operation</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Calls</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Cost</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Share</th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                <% operation_rows.each do |row| %>
                  <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header"><%= row[:label] %></th>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_number(row[:calls]) %></td>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_cost(row[:total_cost_usd]) %></td>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_share(row[:share]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </section>
        <% end %>

        <% model_rows = search_analytics_ai_model_rows(ai_costs[:models], total_cost: ai_cost_summary[:total_cost_usd]) %>
        <% if model_rows.any? %>
          <section class="search-analytics-ai-cost__breakdown govuk-!-margin-top-6" aria-labelledby="ai-cost-models-heading">
            <h3 id="ai-cost-models-heading" class="govuk-heading-m">Cost by model</h3>
            <table class="govuk-table">
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">Model</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Calls</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Cost</th>
                  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Share</th>
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                <% model_rows.each do |row| %>
                  <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header"><%= row[:label] %></th>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_number(row[:calls]) %></td>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_cost(row[:total_cost_usd]) %></td>
                    <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_share(row[:share]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </section>
        <% end %>
    </section>
    <% elsif availability[:journey_metrics] && availability[:costs_match_view] == true %>
      <p class="govuk-body">AI cost data has not been collected for these dates. Other search metrics remain available.</p>
    <% end %>
    <% end %>

    <div class="search-analytics-charts govuk-!-margin-top-6">
      <section>
        <h2 class="govuk-heading-m">Search volume</h2>
        <div class="search-analytics-chart-container">
          <canvas class="search-analytics-chart"
                  data-x-axis-title="<%= @search_analytics.bucket_size == 'hour' ? 'Hour (UTC)' : 'Date (UTC)' %>" data-y-axis-title="Searches"
                  data-chart="<%= search_analytics_chart_payload(trends[:volume], series: { @view => @view.humanize }, bucket_size: @search_analytics.bucket_size) %>"></canvas>
        </div>
      </section>

      <section>
        <h2 class="govuk-heading-m">Outcome trend</h2>
        <% outcome_coverage = (availability[:journey_outcome_coverage] || {}).with_indifferent_access %>
        <% if availability[:journey_outcomes] == true %>
          <% if outcome_coverage[:complete] == false %>
            <%= govuk_inset_text(text: "Outcome figures describe collected days only. Missing days are not zero-outcome days.") %>
          <% end %>
          <div class="search-analytics-chart-container">
            <canvas class="search-analytics-chart"
                    data-x-axis-title="<%= @search_analytics.bucket_size == 'hour' ? 'Hour (UTC)' : 'Date (UTC)' %>" data-y-axis-title="Journeys"
                    data-chart="<%= search_analytics_chart_payload(trends[:outcomes], series: { completed: "Completed", failed: "Failed", nonterminal: "Question only", unknown: "Unknown", zero_result: "Zero result", selected: "Selected" }, bucket_size: @search_analytics.bucket_size) %>"></canvas>
          </div>
        <% else %>
          <p class="govuk-body">Journey outcomes have not been collected for these dates.</p>
        <% end %>
      </section>
    </div>

    <% journeys = (@search_analytics.journeys || {}).with_indifferent_access %>
    <% backend_questions = search_analytics_frontend_question_rows(journeys[:question_counts]) %>
    <% if @view != "classic" && backend_questions.any? %>
      <section class="govuk-!-margin-top-6" aria-labelledby="backend-questions-heading">
        <h2 id="backend-questions-heading" class="govuk-heading-m">Backend questions per journey</h2>
        <p class="govuk-body">Uses the highest backend question count per journey. Unknown is separate from zero.</p>
        <div class="search-analytics-chart-container">
          <canvas class="search-analytics-chart" data-chart-type="bar"
                  data-x-axis-title="Backend questions" data-y-axis-title="Journeys" data-hide-legend="true" data-hide-x-grid="true"
                  data-chart="<%= search_analytics_frontend_chart_payload(backend_questions, label: "Journeys") %>"
                  role="img" aria-label="Backend questions per journey. View question data below for the counts."></canvas>
        </div>
        <%= render GovukComponent::DetailsComponent.new(summary_text: "View backend question data") do %>
          <%= govuk_table(head: ["Maximum backend questions", "Observed journeys"], rows: backend_questions.map { |label, count| [label, search_analytics_number(count)] }) %>
        <% end %>
      </section>
    <% end %>

    <%= render "frontend_events", frontend_events: (@search_analytics.frontend_events || {}).with_indifferent_access %>

    <section class="govuk-!-margin-top-6" aria-labelledby="zero-search-terms-heading">
      <h2 id="zero-search-terms-heading" class="govuk-heading-m">Zero search terms</h2>
      <% if availability.dig(:terms_complete, @term_filter) == false %>
        <%= govuk_inset_text do %>
          Term rankings are unavailable because at least one collected day reached its term limit.
        <% end %>
      <% end %>
      <div class="search-analytics-term-controls govuk-!-margin-bottom-3">
        <% [["search_terms", "Search terms"], ["item_ids", "Item IDs"]].each do |filter, label| %>
          <%= link_to label,
                      search_analytics_path(@analytics_params.merge(term_filter: filter)),
                      class: ["govuk-link", ("govuk-!-font-weight-bold" if @term_filter == filter)].compact.join(" ") %>
        <% end %>
      </div>
      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Query</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Zero-result searches</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <% @improvement_terms.each do |term| %>
            <% term = term.with_indifferent_access %>
            <tr class="govuk-table__row">
              <td class="govuk-table__cell" data-improvement-term-query><%= term[:query] %></td>
              <td class="govuk-table__cell govuk-table__cell--numeric"><%= search_analytics_number(term[:zero_results]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= paginate @improvement_terms, params: @analytics_params.merge(term_filter: @term_filter) %>
    </section>
    <% end %>
  </div>
</div>
