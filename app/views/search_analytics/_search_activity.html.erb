<% action_summary = (actions[:summary] || {}).with_indifferent_access %>
<% action_coverage = (actions[:coverage] || {}).with_indifferent_access %>

<section class="search-analytics-activity govuk-!-margin-bottom-6" aria-labelledby="search-activity-heading">
  <h2 id="search-activity-heading" class="govuk-heading-m">Search activity</h2>
  <p class="govuk-body">Frontend journeys in the selected period and view. Navigation matches a suggestion; Search does not. These describe how a journey starts, not clicks on its results.</p>

  <div class="search-analytics-metrics">
    <% { total: "Total journeys" }.merge(SearchAnalyticsHelper::SEARCH_ACTION_LABELS).each do |key, label| %>
      <section class="search-analytics-metric" aria-label="<%= label %>">
        <h3 class="govuk-heading-s"><%= label %></h3>
        <p class="search-analytics-metric__value"><%= search_analytics_action_count(action_summary[key]) %></p>
      </section>
    <% end %>
  </div>

  <% if action_summary[:total].nil? %>
    <p class="govuk-body govuk-!-margin-top-3">Search activity is unavailable for these dates.</p>
  <% elsif actions[:available] != true %>
    <%= govuk_inset_text(text: "Navigation and Search are unavailable for these dates. Historical totals remain unclassified.") %>
  <% else %>
    <% if action_coverage[:complete] == false %>
      <%= govuk_inset_text do %>
        Action breakdown collected for <%= action_coverage[:collected_days] %> of <%= action_coverage[:expected_days] %> UTC days.
        Navigation and Search counts cover classified journeys only. Missing breakdowns are not zero activity.
      <% end %>
    <% end %>
    <% if action_summary[:total].zero? %>
      <p class="govuk-body govuk-!-margin-top-3">No journeys were recorded on the collected days.</p>
    <% end %>
  <% end %>
</section>
