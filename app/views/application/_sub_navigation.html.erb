<nav class="app-sub-navigation<%= " app-sub-navigation--nested" if local_assigns[:nested] %>" aria-label="<%= section.label %>">
  <ul class="app-sub-navigation__list">
    <% section.items.each do |item| %>
      <% current = item_active?(item) %>
      <li class="app-sub-navigation__item<%= " app-sub-navigation__item--current" if current %>">
        <%= link_to item.text, item.href,
              class: "app-sub-navigation__link",
              **({ "aria-current": "page" } if current).to_h %>
      </li>
    <% end %>
  </ul>
</nav>
